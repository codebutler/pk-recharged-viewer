  "encryption": {
    "security_key": {
      "location": "SaveBlock2 + 0xAC (u32 encryptionKey) -- NOTE: FireRed keeps it at 0xF20 instead",
      "source": "pokeemerald/include/global.h:532"
    },
    "xor_full_u32_key": [
      {
        "field": "SaveBlock1.money (0x490)",
        "source": "src/money.c:74, src/load_save.c:291"
      },
      {
        "field": "SaveBlock1.gameStats[0..63] (0x159C, u32 each)",
        "source": "src/overworld.c:452-467"
      },
      {
        "field": "SaveBlock2.berryCrush.berryPowderAmount (SB2+0x1F4)",
        "source": "src/berry_powder.c:128-142"
      }
    ],
    "xor_low_u16_key": [
      {
        "field": "SaveBlock1.coins (0x494)",
        "source": "src/coins.c:43-48 (u16 result truncates key)"
      },
      {
        "field": "quantity of every slot in the 5 bag pockets (Items/KeyItems/PokeBalls/TMHM/Berries)",
        "source": "src/item.c:26-33,46-54; u16 ^= u32 key truncates to key & 0xFFFF"
      }
    ],
    "not_encrypted": [
      "all item IDs (bag and PC)",
      "PC item quantities (src/item.c:35-43 GetPCItemQuantity returns raw value)",
      "registeredItem, playtime, badges/flags, vars, party/box Pokemon outer fields"
    ],
    "pokemon_data": {
      "region": "BoxPokemon.secure (offset 0x20, 48 bytes, 12 u32 words)",
      "algorithm": [
        "1. key = personality ^ otId (both plaintext at BoxPokemon+0x00/+0x04)",
        "2. decrypt: each of the 12 u32 words ^= key (src/pokemon.c:3546-3554 DecryptBoxMon)",
        "3. locate substructs: order = substruct_permutation.type_to_slot[personality % 24]",
        "4. verify: u16 sum of all 24 u16 words of the decrypted 48-byte block == BoxPokemon.checksum (+0x1C) (src/pokemon.c:2790-2812)"
      ],
      "notes": "empty slots have personality==0 and hasSpecies==0; a failed checksum marks a Bad Egg in-game"
    }
  },
