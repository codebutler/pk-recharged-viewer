{#- Recharged Yellow save-state report. Rendered by generate_page.py with
    autoescape on: every value is escaped unless explicitly marked safe
    (font_css and the data-URI sprite fields, which the generator builds). -#}
{%- macro sprite(uri, cls, label) -%}
{%- if uri -%}
<img class="{{ cls }}" src="{{ uri|safe }}" alt="{{ label }}" title="{{ label }}">
{%- else -%}
<span class="{{ cls }} ph" title="{{ label }}">?</span>
{%- endif -%}
{%- endmacro -%}

{%- macro bar(pct, color) -%}
<span class="bar"><span class="fill" style="width:{{ pct }}%;background:{{ color }}"></span></span>
{%- endmacro -%}

{%- macro type_chip(t, cls="type") -%}
<span class="{{ cls }}" style="background:{{ t.color }}">{{ t.name|upper }}</span>
{%- endmacro -%}

{%- macro panel(title) -%}
<section class="panel"><h2>{{ title }}</h2>{{ caller() }}</section>
{%- endmacro -%}

{#- A section that may carry an error or an empty message renders honestly. -#}
{%- macro simple_states(sec) -%}
{%- if sec.error %}<p class="empty">{{ sec.error }}</p>
{%- elif sec.empty %}<p class="empty">{{ sec.empty }}</p>{% endif -%}
{%- endmacro -%}

{%- macro mon_card(m) -%}
<div class="mon">
  <div class="mon-head">{{ sprite(m.sprite, "spr big", m.species) }}<div>
    <div class="mon-name">{{ m.name }}{% if m.shiny %}<span class="shiny" title="shiny">&#9733;</span>{% endif %}</div>
    <div class="mon-sub">{{ m.species }} &middot; Lv{{ m.level }} {% if m.ailment %}<span class="ail">{{ m.ailment }}</span>{% endif %}</div>
    <div class="types">{% for t in m.types %}{{ type_chip(t) }}{% endfor %}</div></div></div>
  <div class="hp"><i class="explabel">HP</i>{{ bar(m.hp_pct, m.hp_color) }}<span class="hpnum">{{ m.hp }}/{{ m.max_hp }}</span></div>
  {%- if m.exp_pct is not none %}
  <div class="hp exp"><i class="explabel">EXP</i>{{ bar(m.exp_pct, "#40a8f8") }}<span class="expnum">{{ "{:,}".format(m.exp_to_next) }} to Lv{{ m.level + 1 }}</span></div>
  {%- elif m.maxed %}
  <div class="hp exp"><i class="explabel">EXP</i>{{ bar(100, "#40a8f8") }}<span class="expnum">MAX Lv</span></div>
  {%- endif %}
  <ul class="moves">{% for mv in m.moves %}
    <li><span>{{ mv.name }}{% if mv.type %}{{ type_chip(mv.type, "type mtype") }}{% endif %}</span> <span class="pp">PP {{ mv.pp }}</span></li>
  {%- endfor %}</ul>
  <div class="mon-meta">{{ m.ability }} &middot; {{ m.nature }} nature{% if m.friendship is not none %} &middot; FRIEND {{ m.friendship }}{% endif %}</div>
  <div class="statbars"><span class="legend"><i style="background:#68a0e8"></i><b>IV</b><i style="background:#e8a068"></i><b>EV</b></span>
  {%- for row in m.stat_rows %}
    <div class="sb"><i>{{ row.label }}</i>{{ bar(row.iv_pct, "#68a0e8") }}{{ bar(row.ev_pct, "#e8a068") }}</div>
  {%- endfor %}</div>
  {%- if m.held %}<div class="held">holds {{ m.held }}</div>{% endif %}
</div>
{%- endmacro -%}
<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>{{ font_css|safe }}{% include "report.css" %}{{ cursor_css|safe }}</style></head><body>
<h1>POKEMON RECHARGED YELLOW<small>save state report &middot; {{ player_name }}</small></h1>
<main>
{%- if not in_game %}
<section class="panel"><h2>No save loaded</h2><p class="empty">{{ error }}</p></section>
{%- else %}

<div class="tc-top">
<section class="panel tcard">
{%- if trainer.error %}<h2>Trainer Card</h2><p class="empty">{{ trainer.error }}</p>
{%- else %}
  <div class="tc-band"><h2>TRAINER CARD</h2><span class="tc-idno">{{ trainer.idno }}</span></div>
  <div class="tc-white">
    <div class="tc-fields">
      <div class="tc-frow"><i></i><span>Name: <b class="tc-namev">{{ trainer.name }}</b></span></div>
      {%- for f in trainer.fields %}
      <div class="tc-frow"><i></i><span>{{ f[0] }}</span><b>{{ f[1] }}</b></div>
      {%- endfor %}
    </div>
    {%- if trainer.pic %}<img class="tc-pic" src="{{ trainer.pic|safe }}" alt="trainer">
    {%- elif trainer.sprite %}<img class="tc-pic tc-pic-ow" src="{{ trainer.sprite|safe }}" alt="{{ trainer.sprite_alt }}" title="overworld sprite (full-body art unavailable)">{% endif %}
  </div>
  <div class="tc-badgeband"><span class="tc-badgelabel">BADGES</span>
    <span class="tc-badges">{% for b in trainer.badges %}
      {%- if b.lit and b.sprite %}<img class="badge" src="{{ b.sprite|safe }}" alt="{{ b.name }} Badge" title="{{ b.name }} Badge">
      {%- else %}<span class="badge-slot" title="{{ b.name }} Badge (not earned)"></span>{% endif -%}
    {% endfor %}</span>
  </div>
{%- endif %}
</section>
<div class="mapslot">
{%- if map.error %}<p class="empty">{{ map.error }}</p>
{%- elif map.crop %}
  <div class="maparea{{ ' toggleable' if not map.small }}" id="maptoggle"
       title="{{ map.name }} at {{ map.coords }}{% if map.phase %}, {{ map.phase }}{% endif %}{{ ' -- click to toggle full map' if not map.small }}">
    <img class="mapimg crop" src="{{ map.crop|safe }}" alt="terrain around the player at {{ map.name }} {{ map.coords }}">
    {%- if not map.small %}<img class="mapimg full" src="{{ map.full|safe }}" alt="full map of {{ map.name }}">{% endif %}
    <span class="map-popup town">{{ map.name }}</span>
    {%- if map.clock12 %}<span class="map-popup clock">{{ map.clock12 }}</span>{% endif %}
  </div>
{%- endif %}
</div>
</div>

{#- Tab bar (progressive enhancement: hidden until the inline script enables
    it; without JS every pane below stays visible). -#}
<div id="tabbar" role="tablist" aria-label="Sections" hidden>
{%- for t in tabs %}
  <button role="tab" data-tab="{{ t.id }}" id="tab-{{ t.id }}"
          aria-controls="pane-{{ t.id }}" aria-selected="false"
          class="{{ 'tab-empty' if t.empty }}">{{ t.label }}</button>
{%- endfor %}
</div>

<div class="pane" id="pane-party" role="tabpanel" aria-labelledby="tab-party">
{%- call panel("Party") %}{{ simple_states(party) }}
{%- if party.mons %}<div class="party">{% for m in party.mons %}{{ mon_card(m) }}{% endfor %}</div>{% endif %}
{%- endcall %}
</div>

<div class="pane" id="pane-bag" role="tabpanel" aria-labelledby="tab-bag">
{%- call panel("Bag") %}{{ simple_states(bag) }}
{%- if bag.pockets %}<div class="pockets">
  {%- for p in bag.pockets %}
  <div class="pocket"><h3>{{ p.label }}</h3>
    {%- if p.slots %}<ul class="items">
      {%- for it in p.slots %}
      <li>{% if it.sprite %}<img class="ispr" src="{{ it.sprite|safe }}" alt="">{% else %}<span class="ispr ph">?</span>{% endif -%}
        <span class="iname">{{ it.name }}</span><span class="qty">&times;{{ it.qty }}</span></li>
      {%- endfor %}</ul>
    {%- else %}<p class="pocket-empty">empty</p>{% endif %}</div>
  {%- endfor %}</div>
  {%- if bag.registered %}<p class="note">SELECT registered: {{ bag.registered }}</p>{% endif %}
  {%- if bag.warning %}<p class="warn">{{ bag.warning }}</p>{% endif %}
{%- endif %}
{%- endcall %}
</div>

<div class="pane" id="pane-pokedex" role="tabpanel" aria-labelledby="tab-pokedex">
{%- call panel("Pokedex") %}
{%- if dex.error %}<p class="empty">{{ dex.error }}</p>
{%- else %}
  <div class="dexcount"><div><b>{{ dex.seen_count }}</b><i>SEEN</i></div><div><b>{{ dex.owned_count }}</b><i>OWNED</i></div></div>
  {%- if dex.empty %}<p class="empty">{{ dex.empty }}</p>
  {%- else %}
  <p class="note">color = owned &middot; silhouette = seen only</p>
  <div class="grid dexgrid">{% for c in dex.cells %}<span class="cell">{{ sprite(c.sprite, "spr sm" if c.owned else "spr sm seen", c.label) }}</span>{% endfor %}</div>
  {%- endif %}
{%- endif %}
{%- endcall %}
</div>

<div class="pane" id="pane-storage" role="tabpanel" aria-labelledby="tab-storage">
{%- call panel("Pokemon Storage") %}{{ simple_states(boxes) }}
{%- if boxes.shown %}
  <p class="note">{{ boxes.total }} Pokemon stored &middot; current box: {{ boxes.current }}{% if boxes.n_empty %} &middot; {{ boxes.n_empty }} empty boxes not shown{% endif %}</p>
  <div class="boxes">
  {%- for box in boxes.shown %}
  <div class="box"><h3>{{ box.name }}</h3><div class="grid">
    {%- for cell in box.cells %}<span class="cell">{% if cell %}{{ sprite(cell.sprite, "spr sm", cell.label) }}{% endif %}</span>{% endfor -%}
  </div></div>
  {%- endfor %}</div>
{%- endif %}
{%- endcall %}
</div>

<div class="pane" id="pane-stats" role="tabpanel" aria-labelledby="tab-stats">
{%- call panel("Game Stats") %}{{ simple_states(game_stats) }}
{%- if game_stats.rows %}<table class="stats">
  {%- for row in game_stats.rows %}<tr><td>{{ row[0] }}</td><td>{{ row[1] }}</td></tr>{% endfor -%}
</table>{% endif %}
{%- endcall %}
</div>

<div class="pane" id="pane-more" role="tabpanel" aria-labelledby="tab-more">
{%- if rival %}
{%- call panel("Rival") %}<p class="big">{{ rival }}</p>{% endcall %}
{%- endif %}
{%- if challenge %}
{%- call panel("Challenge") %}{{ simple_states(challenge) }}
{%- if challenge.cap %}<p class="big">LEVEL CAP <b>{{ challenge.cap }}</b> (mode {{ challenge.mode }})</p>{% endif %}
{%- endcall %}
{%- endif %}

{%- call panel("Mail") %}{{ simple_states(mail) }}
{%- if mail.entries %}<ul>
  {%- for e in mail.entries %}<li>slot {{ e.slot }} ({{ e.kind }}): item #{{ e.item_id }} from {{ e.sender }}</li>{% endfor -%}
</ul>{% endif %}
{%- endcall %}
</div>

<script>
(function () {
  "use strict";
  var bar = document.getElementById("tabbar");
  if (!bar) return;
  var tabs = [].slice.call(bar.querySelectorAll("button"));
  if (!tabs.length) return;
  bar.hidden = false;
  document.body.classList.add("tabs-on");
  function select(id, pushHash) {
    tabs.forEach(function (b) {
      var on = b.dataset.tab === id;
      b.setAttribute("aria-selected", String(on));
      b.tabIndex = on ? 0 : -1;
      document.getElementById("pane-" + b.dataset.tab).hidden = !on;
    });
    if (pushHash && "#" + id !== location.hash)
      history.replaceState(null, "", "#" + id);
  }
  function valid(id) {
    return tabs.some(function (b) { return b.dataset.tab === id; });
  }
  bar.addEventListener("click", function (e) {
    var b = e.target.closest("button");
    if (b) select(b.dataset.tab, true);
  });
  bar.addEventListener("keydown", function (e) {
    var i = tabs.indexOf(document.activeElement);
    if (i < 0 || (e.key !== "ArrowRight" && e.key !== "ArrowLeft")) return;
    var j = (i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length;
    tabs[j].focus();
    select(tabs[j].dataset.tab, true);
    e.preventDefault();
  });
  window.addEventListener("hashchange", function () {
    var id = location.hash.slice(1);
    if (valid(id)) select(id, false);
  });
  var initial = location.hash.slice(1);
  select(valid(initial) ? initial : tabs[0].dataset.tab, false);
  var mt = document.getElementById("maptoggle");
  if (mt && mt.classList.contains("toggleable"))
    mt.addEventListener("click", function () {
      mt.classList.toggle("showfull");
    });
})();
</script>

{%- endif %}
</main>
<footer>Generated locally by generate_page.py. Sprites and metadata from
PokeAPI (cached at generate time; page is fully offline). Types and abilities
are current-generation PokeAPI data and may postdate Gen 3.
{% if caveats %}Non-high-confidence sections: {{ caveats }}.{% endif %}</footer>
</body></html>
