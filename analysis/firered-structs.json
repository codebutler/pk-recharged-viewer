  "encryption": {
    "security_key": {
      "location": "SaveBlock2 + 0xF20 (u32 encryptionKey)",
      "source": "pokefirered/include/global.h:358"
    },
    "xor_full_u32_key": [
      {
        "field": "SaveBlock1.money (0x290)",
        "source": "src/money.c:14, src/load_save.c:296"
      },
      {
        "field": "SaveBlock1.gameStats[0..63] (0x1200, u32 each)",
        "source": "src/overworld.c:394-401"
      },
      {
        "field": "SaveBlock1.trainerTower[i].bestTime (0x3D38+i*0xC+0x4, i<4)",
        "source": "src/load_save.c:290-291"
      },
      {
        "field": "SaveBlock2.berryCrush.berryPowderAmount (0xAF8)",
        "source": "src/berry_powder.c:19-30"
      }
    ],
    "xor_low_u16_key": [
      {
        "field": "SaveBlock1.coins (0x294)",
        "source": "src/coins.c:13-18 (u16 result truncates key)"
      },
      {
        "field": "quantity of every slot in the 5 bag pockets (Items/KeyItems/PokeBalls/TMHM/Berries)",
        "source": "src/item.c:21-28,41-52; u16 ^= u32 key truncates to key & 0xFFFF"
      }
    ],
    "not_encrypted": [
      "all item IDs (bag and PC)",
      "PC item quantities (src/item.c:31-40 GetPcItemQuantity XORs with 0)",
      "registeredItem, playtime, badges/flags, vars, party/box Pokemon outer fields"
    ],
    "pokemon_data": {
      "region": "BoxPokemon.secure (offset 0x20, 48 bytes, 12 u32 words)",
      "algorithm": [
        "1. key = personality ^ otId (both plaintext at BoxPokemon+0x00/+0x04)",
        "2. decrypt: each of the 12 u32 words ^= key (src/pokemon.c:2807-2815 DecryptBoxMon)",
        "3. locate substructs: order = substruct_permutation.type_to_slot[personality % 24]",
        "4. verify: u16 sum of all 24 u16 words of the decrypted 48-byte block == BoxPokemon.checksum (+0x1C) (src/pokemon.c:2069-2091)"
      ],
      "notes": "empty slots have personality==0 and hasSpecies==0; a failed checksum marks a Bad Egg in-game"
    }
  },
